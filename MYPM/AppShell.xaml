<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       xmlns:p="clr-namespace:MYPM.Pages"
       x:Class="MYPM.AppShell"
       Shell.TabBarIsVisible="True"
       Shell.TabBarBackgroundColor="#FFF"
       Shell.TabBarForegroundColor="#000"
       Shell.TabBarTitleColor="#000"
       Shell.TabBarUnselectedColor="#A0A0A0"
       Shell.TabBarDisabledColor="#CCCCCC"
       Shell.PresentationMode="Animated"
       Shell.BackgroundColor="#FFF"
       Shell.TitleColor="Black"
       Shell.ForegroundColor="Black"
       Background="{StaticResource DarkBg1Transparent}"
       Title="Yousuf Tailor">

    <Shell.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource DarkBg1Transparent}" StatusBarStyle="DarkContent" />
    </Shell.Behaviors>

    <TabBar>
        <Tab Title="Home"
             Icon="home.svg">
            <ShellContent ContentTemplate="{DataTemplate p:HomePage}" />
        </Tab>
        <Tab Title="QR"
             Icon="qr_code.svg">
            <ShellContent ContentTemplate="{DataTemplate p:OrderQRScreenerPage}" />
        </Tab>
        <Tab Title="Orders"
             Icon="order.svg">
            <ShellContent ContentTemplate="{DataTemplate p:NewOrderListPage}" />
        </Tab>
    </TabBar>
</Shell>
