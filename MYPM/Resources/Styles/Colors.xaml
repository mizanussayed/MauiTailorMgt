<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <!-- Brand colors -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="Secondary">#1F2937</Color>
    <Color x:Key="Tertiary">#8B5CF6</Color>
    <Color x:Key="Neutral">#969696</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#111827</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="Warning">#F59E0B</Color>

    <!-- Surface system -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#F3F4F6</Color>
    <Color x:Key="OnSurface">#111827</Color>
    <Color x:Key="CardStroke">#E5E7EB</Color>

    <!-- Text colors -->
    <Color x:Key="Text_Light">#000000</Color>
    <Color x:Key="Text_Dark">#FFFFFF</Color>
    <Color x:Key="TextOnSolid_Light">#FFFFFF</Color>
    <Color x:Key="TextOnSolid_Dark">#000000</Color>
    <Color x:Key="TextSecondary_Light">#4B5563</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>

    <!-- Legacy dark bg names mapped to modern palette -->
    <Color x:Key="DarkBg1">#252836</Color>
    <Color x:Key="DarkBg2">#1F1D2B</Color>
    <Color x:Key="DarkBg1Transparent">#F3F4F6</Color>

    <!-- Status colors -->
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="Danger">#EF4444</Color>

    <!-- Shadow base color -->
    <Color x:Key="Shadow">#000000</Color>

    <!-- Brushes -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStroke}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
</ResourceDictionary>