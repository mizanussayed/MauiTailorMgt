<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Default page background to unify all pages (no theme switching) -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}"/>
    </Style>

    <!-- Flyout grid item style -->
    <Style TargetType="Layout"
            ApplyToDerivedTypes="True"
            Class="FlyoutItemGridStyle">

        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Layout" Class="InnerContent">
        <Setter Property="Margin" Value="15"/>
    </Style>

    <!-- Typography defaults -->
    <Style TargetType="Label">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- SearchBar -->
    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
     <Setter Property="CancelButtonColor" Value="{StaticResource Primary}"/>
        <Setter Property="HeightRequest" Value="44"/>
    </Style>

    <!-- Button base -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextOnSolid_Light}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000" Offset="0,4" Radius="8" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Neutral}" />
                            <Setter Property="TextColor" Value="White"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Outline button -->
    <Style TargetType="Button" x:Key="PrimaryButtonOutline">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- Borderless text button -->
    <Style TargetType="Button" x:Key="BorderlessButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- Horizontal rule -->
    <Style TargetType="BoxView" x:Key="HRule">
        <Setter Property="Color" Value="{StaticResource CardStroke}"/>
        <Setter Property="HeightRequest" Value="1"/>
    </Style>

    <Style TargetType="StackLayout" Class="CheckBoxContainer">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <Style TargetType="StackLayout" Class="SwitchContainer">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <Style TargetType="Picker" ApplyToDerivedTypes="True">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceVariant}"/>
        <Setter Property="HeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}"/>
    </Style>


    <Style TargetType="Image">
        <Setter Property="Aspect" Value="AspectFit"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000" Offset="0,6" Radius="12" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Floating action button -->
    <Style x:Key="FabButton" TargetType="Button">
        <Setter Property="WidthRequest" Value="60"/>
        <Setter Property="HeightRequest" Value="60"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#55000000" Offset="0,8" Radius="14" Opacity="0.7"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>