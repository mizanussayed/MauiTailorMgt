<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MYPM.ViewModels"
             xmlns:model="clr-namespace:MYPM.Data.Models;assembly=MYPM.Data"
             x:Class="MYPM.Pages.NewOrderPage"
             x:DataType="vm:NewOrderPageViewModel"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             Background="{StaticResource DarkBg1Transparent}"
             Title="New Order">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FFF" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="ControlTemplate" Value="{StaticResource ButtonRadioTemplate}"/>
        </Style>
        <Style TargetType="RoundRectangle">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlaceholderColor" Value="#999"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="#444"/>
            <Setter Property="Margin" Value="0,0"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Stroke" Value="#ccc"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Padding" Value="0,0"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="*,108"  ColumnSpacing="10">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Margin="24">
                    <Label  Text="SL : " x:Name="OrderSerialText"/>
                    <Label Text="Name"/>
                    <Border>
                        <Border.StrokeShape>
                            <RoundRectangle />
                        </Border.StrokeShape>
                        <Entry Placeholder="Enter  Name" Text="{Binding Order.CustomerName}" />
                    </Border>
                    <Label Text="Mobile Number"/>
                    <Border>
                        <Border.StrokeShape>
                            <RoundRectangle />
                        </Border.StrokeShape>
                        <Entry  Placeholder="01730-298184" Text="{Binding Order.MobileNumber}" Keyboard="Numeric" />
                    </Border>
                    <Label Text="Address"/>
                    <Border HeightRequest="75">
                        <Border.StrokeShape>
                            <RoundRectangle />
                        </Border.StrokeShape>
                        <Entry  Text="{Binding Order.Address}" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Order Date"/>
                            <Border>
                                <Border.StrokeShape>
                                    <RoundRectangle />
                                </Border.StrokeShape>
                                <DatePicker  Date="{Binding Order.OrderDate}" TextColor="{StaticResource TextSecondary_Light}"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Delivery Date"/>
                            <Border>
                                <Border.StrokeShape>
                                    <RoundRectangle />
                                </Border.StrokeShape>
                                <DatePicker Date="{Binding Order.DeliveryDate}" TextColor="{StaticResource TextSecondary_Light}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Measurement For"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout 
                               Spacing="8"
                               RadioButtonGroup.GroupName="OrderFor"
                               RadioButtonGroup.SelectedValue="{Binding Order.OrderFor}">
                            <RadioButton 
                                    Content="Arabian" 
                                    Value="Arabian" 
                                    GroupName="OrderFor" 
                                    />
                            <RadioButton 
                                    Content="Panjabi" 
                                    Value="Panjabi" 
                                    GroupName="OrderFor" 
                                    />
                            <RadioButton 
                                    Content="Selowar" 
                                    Value="Selowar" 
                                    GroupName="OrderFor" 
                                    />
                        </HorizontalStackLayout>

                        <Button Text="Add + " FontAttributes="Bold" Clicked="OnAddMeasurementType" Grid.Column="1"  HorizontalOptions="End"/>
                    </Grid>
                    <StackLayout x:Name="DynamicFormFields">
                    </StackLayout>
                </VerticalStackLayout>
            </ScrollView>
            <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="20">
                <Button Text="Cancel" 
                     WidthRequest="150"
                     HeightRequest="50"
                     BackgroundColor="{StaticResource Accent}"
                     HorizontalOptions="Fill"
                     Command="{Binding CancelCommand}"/>

                <Button Text="Save"
                     WidthRequest="150"
                     HeightRequest="50"
                     Clicked="BtnSaveClicked"
                     HorizontalOptions="Fill"/>

            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>