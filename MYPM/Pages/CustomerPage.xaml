<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MYPM.Pages.CustomerPage"
             xmlns:models="clr-namespace:MYPM.Models"
             xmlns:vm="clr-namespace:MYPM.ViewModels"
             x:DataType="vm:CustomerViewModel"
             Shell.TabBarIsVisible="False"         
             Background="{StaticResource SurfaceVariant}"
             Title="Customer">

    <Grid>
        <Grid RowDefinitions="Auto, *" >
            <Border Style="{StaticResource CardBorder}" 
           Margin="10,10,10,0" 
            Padding="0"
     StrokeThickness="1">
                <SearchBar x:Name="SearchBar"
                    Placeholder="Search by name or phone"
      Background="Transparent"
            FontSize="16"
          TextColor="{StaticResource OnSurface}"
    PlaceholderColor="{StaticResource TextSecondary}"
        CancelButtonColor="{StaticResource Primary}"
             TextChanged="SearchBar_TextChanged"/>
            </Border>

            <CollectionView Grid.Row="1"
    x:Name="CustomerCollection"
           ItemsSource="{Binding Customers}"
 Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerVM">
                        <Border Style="{StaticResource CardBorder}"  Margin="4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CustomerName}"
           FontSize="18"
         FontAttributes="Bold"
   TextColor="{StaticResource OnSurface}" />
                                <Label Text="{Binding MobileNumber}"
         FontSize="14"
     TextColor="{StaticResource OnSurface}" />
                                <Label Text="{Binding Address}"
      FontSize="14"
     TextColor="{StaticResource OnSurface}" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" CommandParameter="{Binding MobileNumber}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Button Text="+"
     Style="{StaticResource FabButton}"
          Clicked="OnAddClicked"
  Margin="0,0,20,30"
     HorizontalOptions="End"
        VerticalOptions="End"
    ZIndex="1" 
            FontSize="32"
     FontAttributes="Bold"
       TextColor="White" />
    </Grid>
</ContentPage>